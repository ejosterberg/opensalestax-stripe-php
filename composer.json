{
    "name": "ejosterberg/opensalestax-stripe-php",
    "description": "Stripe Tax replacement using OpenSalesTax — server-side calculation library for PHP SaaS.",
    "type": "library",
    "license": ["Apache-2.0", "GPL-2.0-or-later"],
    "keywords": [
        "stripe",
        "stripe-tax",
        "opensalestax",
        "tax",
        "sales-tax",
        "saas"
    ],
    "homepage": "https://github.com/ejosterberg/opensalestax-stripe-php",
    "authors": [
        {
            "name": "Eric Osterberg",
            "email": "ejosterberg@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ejosterberg/opensalestax": "^0.3.0",
        "stripe/stripe-php": "^20.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "psr-4": {
            "OpenSalesTax\\Stripe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSalesTax\\Stripe\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite=unit",
        "test-live": "phpunit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
